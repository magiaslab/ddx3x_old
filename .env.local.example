# URL pubblico del sito (senza slash finale)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity CMS ---
# Crea un progetto su https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Token con permesso di lettura (opzionale se il dataset è pubblico)
# SANITY_API_READ_TOKEN=

# --- Stripe Checkout ---
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# --- PayPal Smart Buttons ---
# https://developer.paypal.com/dashboard/applications
# Riusa lo stesso account Business già collegato al sito WordPress
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=  # solo se serviranno API server-side in futuro
